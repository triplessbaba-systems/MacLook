<Window x:Class="MacLook.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacLook Dock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- Replaced at runtime depending on how light the wallpaper is -->
        <SolidColorBrush x:Key="BarText" Color="White" />
        <SolidColorBrush x:Key="BarHover" Color="#2EFFFFFF" />

        <Style x:Key="BarItem" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BarText}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Height="40" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BarHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource BarText}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>

    <!-- Fully transparent pixels above the bar let clicks through; that space is for tooltips and the launch bounce. -->
    <Grid x:Name="Root" UseLayoutRounding="True">
        <Grid x:Name="Bar" VerticalAlignment="Bottom">
            <!-- Frosted glass: blurred wallpaper + tint + hairline on top -->
            <Border x:Name="BgBlur" />
            <Border x:Name="BgTint" BorderThickness="0,1,0,0" />

            <DockPanel LastChildFill="False">
                <!-- Logo: opens the Start menu, like the Windows button -->
                <Button x:Name="StartButton" DockPanel.Dock="Left" Style="{StaticResource BarItem}" Width="44" Padding="0" Margin="6,0,2,0" Click="Start_Click" ToolTip="Başlat">
                    <Path x:Name="StartLogo" Width="17" Height="20" Stretch="Uniform" Fill="{DynamicResource BarText}" Margin="0,0,0,2" />
                </Button>
                <StackPanel x:Name="Items" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" />

                <!-- Far right corner: show desktop, like Windows -->
                <Border x:Name="ShowDesktop" DockPanel.Dock="Right" Width="14" Background="Transparent"
                        ToolTip="Masaüstünü göster" MouseLeftButtonUp="ShowDesktop_Click">
                    <Rectangle Width="1" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                               SnapsToDevicePixels="True" Fill="{DynamicResource BarText}" Opacity="0.35" />
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                    <Button x:Name="OverflowButton" Style="{StaticResource BarItem}" Click="Overflow_Click" ToolTip="Gizli simgeleri göster">
                        <Path Style="{StaticResource Glyph}" Data="M 0.5,5 L 5,0.8 L 9.5,5" />
                    </Button>
                    <StackPanel x:Name="Tray" Orientation="Horizontal" />

                    <Button x:Name="BatteryButton" Style="{StaticResource BarItem}" Click="ControlCenter_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BatteryText" Margin="0,0,6,1" FontSize="12" VerticalAlignment="Center" />
                            <Grid Width="25" Height="12" VerticalAlignment="Center">
                                <Border Width="22" HorizontalAlignment="Left" CornerRadius="3.5" BorderThickness="1" BorderBrush="{DynamicResource BarText}" Opacity="0.45" />
                                <Border x:Name="BatteryLevel" Width="18" HorizontalAlignment="Left" Margin="2,2,0,2" CornerRadius="2" Background="{DynamicResource BarText}" />
                                <Border Width="2" Height="4" HorizontalAlignment="Right" Margin="0,0,1,0" CornerRadius="0,1,1,0" Background="{DynamicResource BarText}" Opacity="0.45" />
                            </Grid>
                        </StackPanel>
                    </Button>

                    <!-- Keyboard language (only when more than one is installed) -->
                    <Button x:Name="LanguageButton" Style="{StaticResource BarItem}" Click="Language_Click" Visibility="Collapsed" ToolTip="Klavye dili (Win+Boşluk)">
                        <TextBlock x:Name="LanguageText" FontSize="12" FontWeight="SemiBold" />
                    </Button>

                    <Button x:Name="ControlCenterButton" Style="{StaticResource BarItem}" Click="ControlCenter_Click" MouseWheel="Volume_Wheel" ToolTip="Denetim Merkezi (tekerlek: ses)">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="14" Margin="0,0,10,0">
                                <Grid x:Name="WifiIcon">
                                    <Path Style="{StaticResource Glyph}" StrokeThickness="1.7"
                                          Data="M 0.6,6.1 A 10.5,10.5 0 0 1 15.4,6.1 M 3.2,8.7 A 6.75,6.75 0 0 1 12.8,8.7 M 5.9,11.4 A 3,3 0 0 1 10.1,11.4" />
                                    <Ellipse Width="2.8" Height="2.8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{DynamicResource BarText}" />
                                </Grid>
                                <Grid x:Name="EthernetIcon" Visibility="Collapsed">
                                    <Path Style="{StaticResource Glyph}" Data="M 4,3 L 0.8,7 L 4,11 M 12,3 L 15.2,7 L 12,11" />
                                    <Path Fill="{DynamicResource BarText}"
                                          Data="M 5,7 A 1,1 0 1 1 7,7 A 1,1 0 1 1 5,7 Z M 7,7 A 1,1 0 1 1 9,7 A 1,1 0 1 1 7,7 Z M 9,7 A 1,1 0 1 1 11,7 A 1,1 0 1 1 9,7 Z" />
                                </Grid>
                            </Grid>
                            <Grid Width="16" Height="14">
                                <Path Fill="{DynamicResource BarText}" Data="M 1,5 H 4 L 7.5,1.8 V 12.2 L 4,9 H 1 Z" />
                                <Path x:Name="VolumeWaves" Style="{StaticResource Glyph}" Data="M 10,4.6 A 3.4,3.4 0 0 1 10,9.4 M 12.2,2.6 A 6.2,6.2 0 0 1 12.2,11.4" />
                                <Path x:Name="VolumeMuted" Style="{StaticResource Glyph}" Data="M 10,4.5 L 15,9.5 M 15,4.5 L 10,9.5" Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ClockButton" Style="{StaticResource BarItem}" Click="Clock_Click" Padding="10,0">
                        <StackPanel>
                            <TextBlock x:Name="Time" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Date" FontSize="11.5" Opacity="0.85" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>

        <Canvas IsHitTestVisible="False">
            <Border x:Name="Tip" Visibility="Collapsed" CornerRadius="6" Padding="10,3,10,4" BorderThickness="1"
                    Background="{DynamicResource TipBg}" BorderBrush="{DynamicResource TipBorder}">
                <TextBlock x:Name="TipText" FontSize="13" Foreground="{DynamicResource TipText}" />
            </Border>
        </Canvas>

        <!-- Hidden tray icons, opened from the ^ button -->
        <Popup x:Name="Overflow" PlacementTarget="{Binding ElementName=OverflowButton}" Placement="Top"
               HorizontalOffset="-74" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource MenuPanel}" MinWidth="0" Padding="6">
                <WrapPanel x:Name="OverflowIcons" MaxWidth="160" />
            </Border>
        </Popup>
    </Grid>
</Window>
