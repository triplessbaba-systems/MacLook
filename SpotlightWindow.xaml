<local:PanelWindow x:Class="MacLook.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacLook"
        Title="MacLook Spotlight"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource PanelText}">
    <!-- The window is as tall as the longest result list; the panel grows inside it. -->
    <Grid x:Name="Panel" Margin="30" VerticalAlignment="Top">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>
        <Border x:Name="BackdropBorder" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.35" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="14" BorderThickness="1" Background="{DynamicResource PanelTint}" BorderBrush="{DynamicResource PanelBorder}" />

        <StackPanel>
            <Grid Height="56" Margin="18,0,18,0">
                <Path HorizontalAlignment="Left" VerticalAlignment="Center" Width="20" Height="20" Stretch="Uniform"
                      Stroke="{DynamicResource PanelSubText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 1.2,5.8 A 4.6,4.6 0 1 1 10.4,5.8 A 4.6,4.6 0 1 1 1.2,5.8 M 9.1,9.1 L 13,13" />
                <TextBlock x:Name="Placeholder" Text="{local:T 'Spotlight Araması'}" FontSize="22" FontWeight="Light" Margin="36,0,0,2"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource PanelSubText}" />
                <TextBox x:Name="Search" FontSize="22" FontWeight="Light" Margin="33,0,0,0" VerticalAlignment="Center"
                         Background="Transparent" BorderThickness="0" SelectionBrush="#990A84FF"
                         Foreground="{DynamicResource PanelText}" CaretBrush="{DynamicResource PanelText}" />
            </Grid>
            <Border x:Name="Divider" Height="1" Background="{DynamicResource PanelBorder}" Visibility="Collapsed" />
            <StackPanel x:Name="Results" Margin="8,6,8,8" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</local:PanelWindow>
