<UserControl x:Class="MacLook.StatusArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacLook"
             VerticalAlignment="Center">
    <UserControl.Resources>
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource BarText}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Button x:Name="OverflowButton" Click="Overflow_Click" ToolTip="{local:T 'Gizli simgeleri göster'}">
            <Path x:Name="Chevron" Style="{StaticResource Glyph}" Data="M 0.5,5 L 5,0.8 L 9.5,5" />
        </Button>
        <StackPanel x:Name="Tray" Orientation="Horizontal" />

        <Button x:Name="BatteryButton" Click="ControlCenter_Click" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BatteryText" Margin="0,0,6,1" FontSize="12" VerticalAlignment="Center" />
                <Grid Width="25" Height="12" VerticalAlignment="Center">
                    <Border Width="22" HorizontalAlignment="Left" CornerRadius="3.5" BorderThickness="1" BorderBrush="{DynamicResource BarText}" Opacity="0.45" />
                    <Border x:Name="BatteryLevel" Width="18" HorizontalAlignment="Left" Margin="2,2,0,2" CornerRadius="2" Background="{DynamicResource BarText}" />
                    <Border Width="2" Height="4" HorizontalAlignment="Right" Margin="0,0,1,0" CornerRadius="0,1,1,0" Background="{DynamicResource BarText}" Opacity="0.45" />
                </Grid>
            </StackPanel>
        </Button>

        <!-- Keyboard language (only when more than one is installed) -->
        <Button x:Name="LanguageButton" Click="Language_Click" Visibility="Collapsed" ToolTip="{local:T 'Klavye dili (Win+Boşluk)'}">
            <TextBlock x:Name="LanguageText" FontSize="12" FontWeight="SemiBold" />
        </Button>

        <Button x:Name="ControlCenterButton" Click="ControlCenter_Click" MouseWheel="Volume_Wheel" ToolTip="{local:T 'Denetim Merkezi (tekerlek: ses)'}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="14" Margin="0,0,10,0">
                    <Grid x:Name="WifiIcon">
                        <Path Style="{StaticResource Glyph}" StrokeThickness="1.7"
                              Data="M 0.6,6.1 A 10.5,10.5 0 0 1 15.4,6.1 M 3.2,8.7 A 6.75,6.75 0 0 1 12.8,8.7 M 5.9,11.4 A 3,3 0 0 1 10.1,11.4" />
                        <Ellipse Width="2.8" Height="2.8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{DynamicResource BarText}" />
                    </Grid>
                    <!-- macOS shows <···> for a wired connection -->
                    <Grid x:Name="EthernetIcon" Visibility="Collapsed">
                        <Path Style="{StaticResource Glyph}" Data="M 4,3 L 0.8,7 L 4,11 M 12,3 L 15.2,7 L 12,11" />
                        <Path Fill="{DynamicResource BarText}"
                              Data="M 5,7 A 1,1 0 1 1 7,7 A 1,1 0 1 1 5,7 Z M 7,7 A 1,1 0 1 1 9,7 A 1,1 0 1 1 7,7 Z M 9,7 A 1,1 0 1 1 11,7 A 1,1 0 1 1 9,7 Z" />
                    </Grid>
                </Grid>
                <Grid Width="16" Height="14">
                    <Path Fill="{DynamicResource BarText}" Data="M 1,5 H 4 L 7.5,1.8 V 12.2 L 4,9 H 1 Z" />
                    <Path x:Name="VolumeWaves" Style="{StaticResource Glyph}" Data="M 10,4.6 A 3.4,3.4 0 0 1 10,9.4 M 12.2,2.6 A 6.2,6.2 0 0 1 12.2,11.4" />
                    <Path x:Name="VolumeMuted" Style="{StaticResource Glyph}" Data="M 10,4.5 L 15,9.5 M 15,4.5 L 10,9.5" Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </Button>

        <Button x:Name="ClockButton" Click="Clock_Click">
            <StackPanel>
                <TextBlock x:Name="Time" HorizontalAlignment="Center" />
                <TextBlock x:Name="Date" FontSize="11.5" Opacity="0.85" HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Hidden tray icons, opened from the chevron button -->
        <Popup x:Name="Overflow" PlacementTarget="{Binding ElementName=OverflowButton}" Placement="Top"
               HorizontalOffset="-74" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource MenuPanel}" MinWidth="0" Padding="6">
                <WrapPanel x:Name="OverflowIcons" MaxWidth="160" />
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
