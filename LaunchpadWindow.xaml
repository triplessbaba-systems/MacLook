<Window x:Class="MacLook.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacLook Launchpad"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}">
    <Grid x:Name="Root" Background="#01000000">
        <Image x:Name="Backdrop" Stretch="Fill" />
        <Border Background="#38000000" />

        <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ContentScale" />
            </Grid.RenderTransform>

            <Canvas ClipToBounds="True">
                <StackPanel x:Name="Pages" Orientation="Horizontal">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="PagesShift" />
                    </StackPanel.RenderTransform>
                </StackPanel>
            </Canvas>

            <Border x:Name="SearchBox" Width="250" Height="30" VerticalAlignment="Top" Margin="0,56,0,0"
                    CornerRadius="8" Background="#2EFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                <Grid>
                    <Path HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                          Stroke="#D9FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 1.2,5.8 A 4.6,4.6 0 1 1 10.4,5.8 A 4.6,4.6 0 1 1 1.2,5.8 M 9.1,9.1 L 13,13" />
                    <TextBlock x:Name="Placeholder" Text="Ara" Foreground="#B3FFFFFF" FontSize="13"
                               Margin="32,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="Search" Margin="29,0,8,0" VerticalAlignment="Center" FontSize="13"
                             Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                             SelectionBrush="#990A84FF" />
                </Grid>
            </Border>

            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,118" />
        </Grid>
    </Grid>
</Window>
