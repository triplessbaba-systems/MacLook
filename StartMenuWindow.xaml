<local:PanelWindow x:Class="MacLook.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacLook"
        Title="{local:T 'MacLook Başlat'}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource PanelText}">
    <local:PanelWindow.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </local:PanelWindow.Resources>

    <!-- Margin leaves room for the shadow -->
    <Grid Margin="30">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>
        <Border x:Name="BackdropBorder" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.3" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="18" BorderThickness="1" Background="{DynamicResource PanelTint}" BorderBrush="{DynamicResource PanelBorder}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="SearchBox" Margin="24,22,24,0" Height="38" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource FieldBorder}">
                <Grid>
                    <Path HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0"
                          Stroke="{DynamicResource PanelSubText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 1.2,5.8 A 4.6,4.6 0 1 1 10.4,5.8 A 4.6,4.6 0 1 1 1.2,5.8 M 9.1,9.1 L 13,13" />
                    <TextBlock x:Name="Placeholder" Text="{local:T 'Uygulama ve belge ara'}" FontSize="14" Margin="38,0,0,1"
                               VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource PanelSubText}" />
                    <TextBox x:Name="Search" Margin="35,0,12,0" VerticalAlignment="Center" FontSize="14"
                             Background="Transparent" BorderThickness="0" SelectionBrush="#990A84FF"
                             Foreground="{DynamicResource PanelText}" CaretBrush="{DynamicResource PanelText}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,10">
                <StackPanel x:Name="HomePage">
                    <DockPanel>
                        <Button x:Name="AllAppsButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="10,4">
                            <TextBlock Text="{local:T 'Tüm Uygulamalar  ›'}" FontSize="12.5" />
                        </Button>
                        <TextBlock Text="{local:T 'Sabitlenenler'}" Style="{StaticResource Heading}" />
                    </DockPanel>
                    <UniformGrid x:Name="PinnedGrid" Columns="6" Rows="3" Height="282" Margin="-8,10,-8,0" />

                    <DockPanel Margin="0,14,0,0">
                        <Button x:Name="LaunchpadButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="10,4">
                            <TextBlock Text="Launchpad  ›" FontSize="12.5" />
                        </Button>
                        <TextBlock Text="{local:T 'Önerilenler'}" Style="{StaticResource Heading}" />
                    </DockPanel>
                    <UniformGrid x:Name="RecentGrid" Columns="2" Margin="-8,8,-8,0" />
                    <TextBlock x:Name="NoRecent" Text="{local:T 'Son açtığın dosyalar burada görünecek.'}" Margin="0,14,0,0"
                               Visibility="Collapsed" Foreground="{DynamicResource PanelSubText}" />
                </StackPanel>

                <DockPanel x:Name="ListPage" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top">
                        <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="10,4">
                            <TextBlock Text="{local:T '‹  Geri'}" FontSize="12.5" />
                        </Button>
                        <TextBlock x:Name="ListTitle" Style="{StaticResource Heading}" />
                    </DockPanel>
                    <ScrollViewer x:Name="ListScroll" Margin="-8,10,-14,0" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ListItems" Margin="0,0,6,0" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <Border Grid.Row="2" Height="64" CornerRadius="0,0,18,18" BorderThickness="0,1,0,0"
                    Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource PanelBorder}">
                <DockPanel Margin="18,0">
                    <Button x:Name="PowerButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="10" ToolTip="{local:T 'Güç'}">
                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                    </Button>
                    <Button x:Name="UserButton" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Padding="8,6" ToolTip="{local:T 'Hesap ayarları'}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Avatar" Width="34" Height="34" Fill="{DynamicResource TileOff}" />
                            <TextBlock x:Name="UserName" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13.5" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</local:PanelWindow>
