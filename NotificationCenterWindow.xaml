<local:PanelWindow x:Class="MacLook.NotificationCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacLook"
        Title="{local:T 'MacLook Bildirim Merkezi'}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource PanelText}">
    <local:PanelWindow.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
    </local:PanelWindow.Resources>

    <Grid Margin="30">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>
        <Border x:Name="BackdropBorder" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.3" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="20" BorderThickness="1" Background="{DynamicResource PanelTint}" BorderBrush="{DynamicResource PanelBorder}" />

        <StackPanel x:Name="Body" Margin="12" Width="336">
            <!-- Clock -->
            <Border Style="{StaticResource Tile}" Padding="16,10,16,12">
                <StackPanel>
                    <TextBlock x:Name="BigTime" FontSize="42" FontWeight="Light" />
                    <TextBlock x:Name="LongDate" FontSize="14" Margin="2,0,0,0" Foreground="{DynamicResource PanelSubText}" />
                </StackPanel>
            </Border>

            <!-- Calendar -->
            <Border Style="{StaticResource Tile}" Margin="0,10,0,0" Padding="14,10,14,12">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="PrevMonth" Style="{StaticResource PillButton}" Padding="8,2" ToolTip="{local:T 'Önceki ay'}">
                                <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                            </Button>
                            <Button x:Name="TodayButton" Style="{StaticResource PillButton}" Padding="8,2" ToolTip="{local:T 'Bugün'}">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PanelSubText}" />
                            </Button>
                            <Button x:Name="NextMonth" Style="{StaticResource PillButton}" Padding="8,2" ToolTip="{local:T 'Sonraki ay'}">
                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="MonthTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid x:Name="WeekDays" Columns="7" Margin="0,10,0,2" />
                    <UniformGrid x:Name="Days" Columns="7" Rows="6" />
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <DockPanel Margin="4,14,0,6">
                <Button x:Name="ClearAll" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="8,3">
                    <TextBlock Text="{local:T 'Tümünü Temizle'}" FontSize="12" />
                </Button>
                <TextBlock Text="{local:T 'Bildirimler'}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer x:Name="NotificationScroll" Margin="0,0,-8,0" Focusable="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NotificationList" Margin="0,0,8,0" />
            </ScrollViewer>
            <TextBlock x:Name="NoNotifications" Text="{local:T 'Yeni bildirim yok'}" Margin="4,6,0,8"
                       Foreground="{DynamicResource PanelSubText}" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</local:PanelWindow>
