<local:PanelWindow x:Class="MacLook.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacLook"
        Title="{local:T 'MacLook Denetim Merkezi'}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource PanelText}">
    <local:PanelWindow.Resources>
        <Style x:Key="ModuleTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
    </local:PanelWindow.Resources>

    <Grid Margin="30">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>
        <Border x:Name="BackdropBorder" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.3" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="20" BorderThickness="1" Background="{DynamicResource PanelTint}" BorderBrush="{DynamicResource PanelBorder}" />

        <StackPanel x:Name="Body" Margin="12" Width="316">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!-- Wi-Fi / Bluetooth / network -->
                <Border Style="{StaticResource Tile}" Padding="10,8">
                    <StackPanel x:Name="Connectivity" VerticalAlignment="Center" />
                </Border>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="10" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border x:Name="FocusTile" Style="{StaticResource Tile}" Padding="10,0" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="NightTile" Style="{StaticResource Tile}" Padding="4" />
                        <Border x:Name="CastTile" Grid.Column="2" Style="{StaticResource Tile}" Padding="4" />
                    </Grid>
                </Grid>
            </Grid>

            <Border x:Name="DisplayModule" Style="{StaticResource Tile}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{local:T 'Ekran'}" Style="{StaticResource ModuleTitle}" />
                    <ContentControl x:Name="DisplaySliderHost" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel>
                        <!-- Opens the list of output devices, like the arrow next to Sound on macOS -->
                        <Button x:Name="OutputsButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="6,1" Margin="0,-4,-4,4" ToolTip="{local:T 'Çıkış aygıtı'}">
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                        </Button>
                        <TextBlock Text="{local:T 'Ses'}" Style="{StaticResource ModuleTitle}" />
                    </DockPanel>
                    <ContentControl x:Name="SoundSliderHost" />
                    <TextBlock x:Name="OutputName" FontSize="11.5" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PanelSubText}" />
                </StackPanel>
            </Border>

            <Border x:Name="MediaModule" Style="{StaticResource Tile}" Margin="0,10,0,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Cover" Width="46" Height="46" CornerRadius="8" Background="{DynamicResource TileOff}" />
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MediaTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MediaArtist" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PanelSubText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Style="{StaticResource PillButton}" Padding="6">
                            <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource PillButton}" Padding="6">
                            <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="18" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource PillButton}" Padding="6">
                            <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid x:Name="SmallTiles" Columns="3" Margin="-5,10,-5,0" />
        </StackPanel>
    </Grid>
</local:PanelWindow>
